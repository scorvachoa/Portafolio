---
/**
 * Proceso de trabajo: timeline horizontal con Swiper.
 */
import process from '@/data/process.json';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
import Icon from '@/components/Icon.astro';
---

<section id="proceso" class="relative overflow-hidden py-24 sm:py-32" aria-label="Proceso de trabajo">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionHeading
        eyebrow={process.label}
        title={process.title}
        description={process.description}
      />

      <Reveal delay="0.1" class="flex gap-3">
        <button
          id="process-prev"
          type="button"
          class="grid size-12 place-items-center rounded-full border border-white/10 bg-white/5 text-white/70 transition-colors hover:border-brand hover:text-brand"
          aria-label="Paso anterior"
          data-cursor="hover"
        >
          <Icon name="chevron-right" size={20} class="rotate-180" />
        </button>
        <button
          id="process-next"
          type="button"
          class="grid size-12 place-items-center rounded-full border border-white/10 bg-white/5 text-white/70 transition-colors hover:border-brand hover:text-brand"
          aria-label="Paso siguiente"
          data-cursor="hover"
        >
          <Icon name="chevron-right" size={20} />
        </button>
      </Reveal>
    </div>
  </div>

  <Reveal class="mt-16">
    <div class="swiper !overflow-visible" id="process-swiper">
      <div class="swiper-wrapper !items-stretch">
        {
          process.steps.map((step, index) => (
            <div class="swiper-slide !h-auto">
              <article class="group relative flex h-full flex-col rounded-2xl border border-white/8 bg-surface-2/60 p-7 transition-colors duration-500 hover:border-brand/30">
                <div class="flex items-center justify-between">
                  <span class="font-display text-xs tracking-[0.25em] text-brand/60">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="grid size-9 place-items-center rounded-full border border-white/10 text-white/40 transition-all duration-500 group-hover:border-brand group-hover:text-brand">
                    <Icon name="arrow-right" size={16} class="rotate-45" />
                  </span>
                </div>

                <h3 class="mt-8 font-display text-2xl font-semibold text-white">{step.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-white/50">{step.description}</p>

                <div class="mt-auto pt-6">
                  <div class="h-px w-full bg-white/8">
                    <div
                      class="h-full w-0 bg-gradient-to-r from-brand-dim to-brand transition-all duration-700 group-hover:w-full"
                      aria-hidden="true"
                    />
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </Reveal>
</section>
