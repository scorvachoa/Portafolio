---
/**
 * Proceso de trabajo: workflow visual estilo n8n en grid 3×3.
 * Nodos conectados por cables animados sobre un canvas con retícula de puntos.
 */
import process from '@/data/process.json';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
import Icon from '@/components/Icon.astro';

// Icono + color por paso (paleta estilo n8n: cada tipo de nodo tiene su color)
const icons = [
  'lightbulb',
  'search',
  'calendar',
  'camera',
  'scissors',
  'wand',
  'trending-up',
  'send',
  'target',
  'sparkles',
];

const palette = [
  '#0ea5e9',
  '#6366f1',
  '#f59e0b',
  '#ec4899',
  '#10b981',
  '#a855f7',
  '#f97316',
  '#22d3ee',
  '#14b8a6',
  '#84cc16',
];

function rgba(hex: string, alpha: number): string {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
}

interface StepMeta {
  index: number;
  icon: string;
  color: string;
  col: number;
  row: number;
  from: 'left' | 'right' | 'top' | null;
  to: 'right' | 'left' | 'down' | null;
}

// Posición serpentina 3×3:
//   fila 1 (1..3) izquierda→derecha, fila 2 (4..6) derecha→izquierda, fila 3 (7..9) izquierda→derecha.
const metas: StepMeta[] = process.steps.map((_, i) => {
  const row = i < 3 ? 1 : i < 6 ? 2 : 3;
  const col = row === 1 ? i + 1 : row === 2 ? 6 - i : i - 5;
  let to: StepMeta['to'] = null;
  if (i === 2 || i === 5) to = 'down'; // bajada al inicio de la fila siguiente
  else if (i === 8) to = null; // último nodo
  else if (row === 1 || row === 3) to = 'right';
  else to = 'left'; // fila 2 fluye hacia la izquierda

  let from: StepMeta['from'] = null;
  if (i === 0) from = null; // primer nodo
  else if (i === 3 || i === 6) from = 'top'; // llega desde la fila anterior
  else if (row === 2) from = 'right'; // fila 2 fluye hacia la izquierda
  else from = 'left';

  return {
    index: i,
    icon: icons[i % icons.length],
    color: palette[i % palette.length],
    col,
    row,
    from,
    to,
  };
});
---

<section id="proceso" class="relative overflow-hidden py-24 sm:py-32" aria-label="Proceso de trabajo">
  <div class="container-page">
    <SectionHeading
      eyebrow={process.label}
      title={process.title}
      description={process.description}
    />
  </div>

  <Reveal class="mt-16">
    <div class="mx-auto max-w-[1000px]">
      <div class="workflow-canvas overflow-x-auto rounded-2xl border border-white/8 p-6 sm:p-8">
        <div class="workflow-grid grid min-w-[720px] grid-cols-3">
          {
            metas.map((meta) => (
              <div
                class="relative flex items-center justify-center py-9"
                style={`--wire: ${meta.color}; grid-column-start: ${meta.col}; grid-row-start: ${meta.row};`}
              >
                {/* Raya de entrada */}
                {meta.from === 'left' && <span class="stub-h left-0" aria-hidden="true" />}
                {meta.from === 'right' && <span class="stub-h right-0" aria-hidden="true" />}
                {meta.from === 'top' && <span class="stub-v top-0" aria-hidden="true" />}
                {/* Raya de salida */}
                {meta.to === 'right' && <span class="stub-h right-0" aria-hidden="true" />}
                {meta.to === 'left' && <span class="stub-h left-0" aria-hidden="true" />}
                {meta.to === 'down' && <span class="stub-v bottom-0" aria-hidden="true" />}

                <article
                  class="n8n-node group relative w-[86%] rounded-xl border border-white/10 bg-[#1b1b22] p-5 transition-colors duration-300 hover:border-white/25"
                  style={`--node: ${meta.color}`}
                  data-cursor="hover"
                >
                  <div class="flex items-center gap-3">
                    <span
                      class="grid size-10 shrink-0 place-items-center rounded-lg text-white"
                      style={`background: ${meta.color}; box-shadow: 0 6px 20px -6px ${rgba(meta.color, 0.8)}`}
                    >
                      <Icon name={meta.icon} size={18} />
                    </span>
                    <div class="min-w-0">
                      <p class="truncate font-display text-sm font-semibold text-white">
                        {process.steps[meta.index].title}
                      </p>
                      <p class="text-[11px] text-white/40">
                        Paso {String(meta.index + 1).padStart(2, '0')}
                      </p>
                    </div>
                  </div>
                  <p class="mt-3 line-clamp-3 text-xs leading-relaxed text-white/55">
                    {process.steps[meta.index].description}
                  </p>
                  {/* Puertos de conexión */}
                  <span class="node-port left-[-4px]" style={`border-color: ${meta.color}`} aria-hidden="true" />
                  <span class="node-port right-[-4px]" style={`border-color: ${meta.color}`} aria-hidden="true" />
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Reveal>
</section>

<style>
  /* Canvas con retícula de puntos (estilo n8n) */
  .workflow-canvas {
    background-image:
      radial-gradient(rgb(255 255 255 / 0.055) 1px, transparent 1px),
      linear-gradient(180deg, rgb(255 255 255 / 0.015), transparent 60%);
    background-size: 22px 22px, 100% 100%;
    background-color: #0d0d12;
    box-shadow: var(--shadow-card);
  }

  /* Rayas cortas de entrada/salida: un solo indicador por lado */
  .stub-h {
    position: absolute;
    top: 50%;
    width: 26%;
    height: 2px;
    transform: translateY(-50%);
    background: color-mix(in srgb, var(--wire) 80%, transparent);
    pointer-events: none;
  }
  .stub-h.left-0 {
    left: 0;
    border-radius: 0 9999px 9999px 0;
  }
  .stub-h.right-0 {
    right: 0;
    border-radius: 9999px 0 0 9999px;
  }

  .stub-v {
    position: absolute;
    left: 50%;
    width: 2px;
    height: 30px;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--wire) 80%, transparent);
    pointer-events: none;
  }
  .stub-v.top-0 {
    top: 0;
    border-radius: 0 0 9999px 9999px;
  }
  .stub-v.bottom-0 {
    bottom: 0;
    border-radius: 9999px 9999px 0 0;
  }

  /* Puertos de entrada/salida del nodo */
  .node-port {
    position: absolute;
    top: calc(50% - 4px);
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #1b1b22;
    border-width: 2px;
    border-style: solid;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .n8n-node:hover .node-port {
    transform: scale(1.35);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--node) 60%, transparent);
  }
</style>
