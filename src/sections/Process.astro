---
/**
 * Proceso de trabajo: grid de tarjetas numeradas con acento de color por paso.
 */
import process from '@/data/process.json';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
import Icon from '@/components/Icon.astro';

const icons = [
  'lightbulb',
  'search',
  'calendar',
  'camera',
  'scissors',
  'wand',
  'trending-up',
  'send',
  'target',
  'sparkles',
];

const palette = [
  '#0ea5e9',
  '#6366f1',
  '#f59e0b',
  '#ec4899',
  '#10b981',
  '#a855f7',
  '#f97316',
  '#22d3ee',
  '#14b8a6',
  '#84cc16',
];

function rgba(hex: string, alpha: number): string {
  const n = parseInt(hex.slice(1), 16);
  return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
}
---

<section id="proceso" class="relative overflow-hidden py-24 sm:py-32" aria-label="Proceso de trabajo">
  <div class="container-page">
    <SectionHeading
      eyebrow={process.label}
      title={process.title}
      description={process.description}
    />

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        process.steps.map((step, index) => {
          const color = palette[index % palette.length];
          return (
            <Reveal delay={(index % 3) * 0.08} class="h-full">
              <article
                class="card group relative h-full overflow-hidden p-6 sm:p-7"
                data-cursor="hover"
              >
                <span
                  class="absolute inset-x-0 top-0 h-1"
                  style={`background: linear-gradient(90deg, ${rgba(color, 0.9)}, ${rgba(color, 0.35)})`}
                  aria-hidden="true"
                />

                <div class="flex items-start justify-between">
                  <span
                    class="grid size-11 place-items-center rounded-xl text-white transition-transform duration-500 group-hover:scale-110"
                    style={`background: ${rgba(color, 0.18)}; border: 1px solid ${rgba(color, 0.45)}; color: ${color}; box-shadow: 0 6px 20px -8px ${rgba(color, 0.8)}`}
                  >
                    <Icon name={icons[index % icons.length]} size={20} />
                  </span>
                  <span
                    class="font-display text-4xl font-bold leading-none"
                    style={`color: ${rgba(color, 0.35)}`}
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                </div>

                <h3 class="mt-6 font-display text-lg font-semibold text-white">
                  {step.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-white/55">
                  {step.description}
                </p>
              </article>
            </Reveal>
          );
        })
      }
    </div>
  </div>
</section>
