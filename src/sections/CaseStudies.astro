---
/**
 * Casos de éxito: lista de proyectos con showcase completo.
 */
import projects from '@/data/projects.json';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
import ProjectShowcase from '@/components/ProjectShowcase.astro';
---

<section id="proyectos" class="relative py-24 sm:py-32" aria-label="Casos de éxito">
  <div class="container-page">
    <SectionHeading
      eyebrow={projects.label}
      title={projects.title}
      description={projects.description}
    />
  </div>

  <Reveal class="mt-16">
    {
      projects.projects.map((project, index) => (
        <ProjectShowcase project={project} index={index} />
      ))
    }
  </Reveal>
</section>
