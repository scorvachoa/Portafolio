---
/**
 * Hero: pantalla completa, video de fondo, overlay oscuro y texto en capas.
 */
import site from '@/data/site.json';
import { asset } from '@/utils/asset';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';

const roles = site.roles;
const hero = site.hero;
---

<section id="inicio" class="relative flex min-h-svh flex-col overflow-hidden" aria-label="Presentación">
  {/* Fondo: imagen */}
  <div class="absolute inset-0" data-parallax data-speed="-0.1">
    <img
      src={asset(hero.image)}
      alt=""
      aria-hidden="true"
      class="size-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  {/* Overlay oscuro */}
  <div
    data-hero-overlay
    class="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/55 to-ink"
    aria-hidden="true"
  />

  {/* Contenido */}
  <div class="container-page relative z-10 flex flex-1 flex-col justify-center pb-24 pt-32">
    <p
      data-hero-eyebrow
      class="mb-6 flex items-center gap-3 font-display text-xs font-medium tracking-[0.3em] text-white/60 uppercase opacity-0"
    >
      <span class="h-px w-10 bg-brand" aria-hidden="true" />
      {hero.eyebrow}
    </p>

    <h1 class="font-display font-bold leading-[0.98] tracking-tight">
      <span
        data-hero-line
        class="block overflow-hidden"
        style="transform: translateY(110%); opacity: 0"
      >
        <span class="block text-[clamp(1.5rem,4vw,3rem)] font-semibold tracking-tight text-brand">
          {site.name}
        </span>
      </span>

      {
        roles.map((role, index) => (
          <span
            data-hero-line
            class:list={[
              'block overflow-hidden',
              index === 0 ? 'text-[clamp(3rem,12vw,9rem)] text-white' : '',
              index === 1
                ? 'text-[clamp(3rem,12vw,9rem)] text-white/35'
                : '',
              index === 2 ? 'text-[clamp(3rem,12vw,9rem)] text-brand' : '',
            ]}
            style="transform: translateY(110%); opacity: 0"
          >
            <span class="block">{role}</span>
          </span>
        ))
      }
    </h1>

    <p
      data-hero-item
      class="mt-8 max-w-xl text-base leading-relaxed text-white/65 sm:text-lg opacity-0"
    >
      {site.tagline}
    </p>

    <div data-hero-actions class="mt-10 flex flex-wrap items-center gap-4 opacity-0">
      <Button href="#proyectos" icon="play" iconRight="arrow-right">
        Ver Portafolio
      </Button>
      <Button href={asset(site.cvUrl)} variant="ghost" icon="download" download>
        Descargar CV
      </Button>
    </div>
  </div>

  {/* Meta inferior + scroll indicator */}
  <div data-hero-meta class="container-page relative z-10 flex items-end justify-between pb-8 opacity-0">
    <div class="hidden items-center gap-8 text-xs text-white/45 sm:flex">
      <span class="flex items-center gap-2">
        <Icon name="map-pin" size={14} class="text-brand" />
        {site.location}
      </span>
      <span class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-emerald-400 animate-pulse-dot" aria-hidden="true" />
        {site.availability}
      </span>
    </div>

    <a
      href="#sobre-mi"
      class="group flex flex-col items-center gap-3 text-white/50 transition-colors hover:text-brand"
      data-cursor="hover"
      aria-label="Bajar a la siguiente sección"
    >
      <span class="font-display text-[10px] tracking-[0.35em] uppercase">Scroll</span>
      <span class="relative h-12 w-px overflow-hidden bg-white/15">
        <span class="absolute left-0 top-0 h-1/2 w-full animate-[scroll-dot_2.2s_ease-in-out_infinite] bg-brand" />
      </span>
    </a>
  </div>
</section>

<style>
  @keyframes scroll-dot {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(220%);
    }
  }
</style>
