---
/**
 * Videos: grid responsive con reproductores embebidos.
 */
import videos from '@/data/videos.json';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
import Icon from '@/components/Icon.astro';

const platforms: Record<string, string> = {
  youtube: 'YouTube',
  tiktok: 'TikTok',
  facebook: 'Facebook',
  instagram: 'Instagram',
};

const embedSrc = (video: { platform: string; id: string; url: string }): string => {
  switch (video.platform) {
    case 'tiktok':
      return `https://www.tiktok.com/player/v1/${video.id}?autoplay=0&mute=0&loop=0`;
    case 'facebook':
      return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(video.url)}&show_text=false&autoplay=false&width=420`;
    default:
      return `https://www.youtube-nocookie.com/embed/${video.id}?rel=0`;
  }
};
---

<section id="videos" class="relative py-24 sm:py-32" aria-label="Videos">
  <div class="container-page">
    <SectionHeading
      eyebrow={videos.label}
      title={videos.title}
      description={videos.description}
    />

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        videos.videos.map((video, index) => (
          <Reveal delay={(index % 3) * 0.08} class="h-full">
            <article class="group flex h-full flex-col">
              <div class="relative aspect-[9/16] w-full overflow-hidden rounded-2xl border border-white/8 bg-surface-2">
                <iframe
                  src={embedSrc(video)}
                  class="absolute inset-0 size-full"
                  title={video.title}
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>

              <div class="mt-4 flex flex-1 flex-col">
                <p class="text-[11px] font-medium uppercase tracking-[0.2em] text-brand/70">
                  {video.category}
                </p>
                <h3 class="mt-1.5 font-display text-lg font-semibold text-white">
                  {video.title}
                </h3>
                <a
                  href={video.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex w-fit items-center gap-2 rounded-full border border-white/15 px-4 py-2 text-xs font-medium text-white/80 transition-colors hover:border-brand hover:bg-brand hover:text-white"
                  aria-label={`Abrir ${video.title} en ${platforms[video.platform] ?? video.platform}`}
                >
                  <Icon name="external-link" size={14} />
                  Ver video original
                </a>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
