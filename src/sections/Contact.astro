---
/**
 * Contacto: formulario (mailto) + canales directos + CV.
 */
import site from '@/data/site.json';
import { asset } from '@/utils/asset';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';

const channels = [
  {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: site.phone,
    href: `https://wa.me/${site.whatsapp}?text=Hola%2C%20quiero%20un%20proyecto%20audiovisual`,
    external: true,
  },
  {
    icon: 'mail',
    label: 'Correo',
    value: site.email,
    href: `mailto:${site.email}`,
    external: false,
  },
  {
    icon: 'linkedin',
    label: 'LinkedIn',
    value: 'Ver perfil',
    href: site.social.linkedin,
    external: true,
  },
];
---

<section id="contacto" class="relative overflow-hidden py-24 sm:py-32" aria-label="Contacto">
  <div
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-96 w-[60rem] -translate-x-1/2 rounded-full bg-brand/10 blur-[120px]"
    aria-hidden="true"
  />

  <div class="container-page">
    <SectionHeading
      eyebrow="Contacto"
      title="Trabajemos juntos en tu próxima historia"
      description="Cuéntame sobre tu proyecto. Respondo en menos de 24 horas con una propuesta concreta."
      align="center"
    />

    <div class="mt-16 grid gap-4 lg:grid-cols-5">
      {/* Canales directos */}
      <Reveal class="lg:col-span-2">
        <div class="flex h-full flex-col gap-4">
          {
            channels.map((channel) => (
              <a
                href={channel.href}
                target={channel.external ? '_blank' : undefined}
                rel={channel.external ? 'noopener noreferrer' : undefined}
                class="card group flex items-center gap-5 p-6"
                data-cursor="hover"
              >
                <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-brand/25 bg-brand/10 text-brand transition-all duration-500 group-hover:bg-brand group-hover:text-white">
                  <Icon name={channel.icon} size={22} />
                </span>
                <span class="min-w-0">
                  <span class="block font-display text-xs font-semibold uppercase tracking-widest text-white/40">
                    {channel.label}
                  </span>
                  <span class="mt-0.5 block truncate text-sm font-medium text-white/85">
                    {channel.value}
                  </span>
                </span>
                <Icon name="external-link" size={16} class="ml-auto text-white/25 transition-colors group-hover:text-brand" />
              </a>
            ))
          }

          <div class="card mt-auto flex items-center justify-between gap-4 p-6">
            <div>
              <p class="font-display text-sm font-semibold text-white">Descarga mi CV</p>
              <p class="mt-1 text-xs text-white/45">Versión actualizada en PDF</p>
            </div>
            <Button href={asset(site.cvUrl)} variant="primary" size="sm" icon="download" download>
              PDF
            </Button>
          </div>
        </div>
      </Reveal>

      {/* Formulario */}
      <Reveal delay="0.1" class="lg:col-span-3">
        <form
          class="card h-full p-8 sm:p-10"
          action={`mailto:${site.email}`}
          method="post"
          enctype="text/plain"
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="mb-2 block text-xs font-medium uppercase tracking-widest text-white/50">
                Nombre
              </label>
              <input
                id="contact-name"
                name="nombre"
                type="text"
                required
                autocomplete="name"
                placeholder="Tu nombre"
                class="w-full rounded-xl border border-white/10 bg-white/4 px-4 py-3.5 text-sm text-white placeholder:text-white/30 transition-colors focus:border-brand focus:outline-none"
              />
            </div>
            <div>
              <label for="contact-email" class="mb-2 block text-xs font-medium uppercase tracking-widest text-white/50">
                Correo
              </label>
              <input
                id="contact-email"
                name="correo"
                type="email"
                required
                autocomplete="email"
                placeholder="tu@correo.com"
                class="w-full rounded-xl border border-white/10 bg-white/4 px-4 py-3.5 text-sm text-white placeholder:text-white/30 transition-colors focus:border-brand focus:outline-none"
              />
            </div>
          </div>

          <div class="mt-5">
            <label for="contact-topic" class="mb-2 block text-xs font-medium uppercase tracking-widest text-white/50">
              ¿Qué necesitas?
            </label>
            <select
              id="contact-topic"
              name="tipo"
              class="w-full appearance-none rounded-xl border border-white/10 bg-white/4 px-4 py-3.5 text-sm text-white transition-colors focus:border-brand focus:outline-none"
            >
              <option class="bg-surface-2" value="produccion">Producción audiovisual</option>
              <option class="bg-surface-2" value="edicion">Edición / Post-producción</option>
              <option class="bg-surface-2" value="estrategia">Estrategia de contenido</option>
              <option class="bg-surface-2" value="fotografia">Fotografía</option>
              <option class="bg-surface-2" value="otro">Otro</option>
            </select>
          </div>

          <div class="mt-5">
            <label for="contact-message" class="mb-2 block text-xs font-medium uppercase tracking-widest text-white/50">
              Cuéntame tu idea
            </label>
            <textarea
              id="contact-message"
              name="mensaje"
              rows="5"
              required
              placeholder="Describe tu proyecto, objetivos y fechas aproximadas..."
              class="w-full resize-none rounded-xl border border-white/10 bg-white/4 px-4 py-3.5 text-sm text-white placeholder:text-white/30 transition-colors focus:border-brand focus:outline-none"
            ></textarea>
          </div>

          <div class="mt-7 flex flex-wrap items-center gap-4">
            <Button type="submit" icon="send">
              Enviar mensaje
            </Button>            <p class="text-xs text-white/35">
              O escríbeme directo por WhatsApp para una respuesta inmediata.
            </p>
          </div>
        </form>
      </Reveal>
    </div>
  </div>
</section>
