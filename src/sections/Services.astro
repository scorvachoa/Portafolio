---
/**
 * Servicios: grid de tarjetas con icono y hover premium.
 */
import services from '@/data/services.json';
import Icon from '@/components/Icon.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
---

<section id="servicios" class="relative py-24 sm:py-32" aria-label="Servicios">
  <div class="container-page">
    <SectionHeading
      eyebrow={services.label}
      title={services.title}
      description={services.description}
    />

    <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        services.services.map((service, index) => (
          <Reveal delay={(index % 3) * 0.08} class="h-full">
            <article class="card group h-full p-7 sm:p-8" data-cursor="hover">
              {/* Resplandor al hover */}
              <div
                class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                style="background: radial-gradient(600px 220px at 50% 0%, rgb(14 165 233 / 0.1), transparent)"
                aria-hidden="true"
              />

              <div class="relative">
                <div class="grid size-12 place-items-center rounded-xl border border-brand/25 bg-brand/10 transition-all duration-500 group-hover:scale-110 group-hover:bg-brand group-hover:text-white">
                  <Icon name={service.icon} size={24} class="text-brand transition-colors duration-500 group-hover:text-white" />
                </div>

                <h3 class="mt-6 font-display text-xl font-semibold text-white">{service.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-white/55">{service.description}</p>

                <div class="mt-6 flex flex-wrap gap-2">
                  {
                    service.tags.map((tag) => (
                      <span class="rounded-full border border-white/8 bg-white/4 px-3 py-1 text-[11px] text-white/50">
                        {tag}
                      </span>
                    ))
                  }
                </div>

                <span
                  class="absolute right-0 top-0 font-display text-xs tracking-widest text-white/15 transition-colors duration-500 group-hover:text-brand/60"
                  aria-hidden="true"
                >
                  0{index + 1}
                </span>
              </div>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
