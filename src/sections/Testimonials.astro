---
/**
 * Testimonios: carrusel Swiper con estructura preparada.
 */
import testimonials from '@/data/testimonials.json';
import { asset } from '@/utils/asset';
import SectionHeading from '@/components/SectionHeading.astro';
import Reveal from '@/components/Reveal.astro';
import Icon from '@/components/Icon.astro';
---

<section class="relative py-24 sm:py-32" aria-label="Testimonios">
  <div class="container-page">
    <SectionHeading
      eyebrow={testimonials.label}
      title={testimonials.title}
      description={testimonials.description}
    />

    <Reveal class="mt-16">
      <div class="swiper" id="testimonials-swiper">
        <div class="swiper-wrapper">
          {
            testimonials.testimonials.map((t) => (
              <div class="swiper-slide !h-auto">
                <figure class="card flex h-full flex-col p-8">
                  <div class="flex items-center justify-between">
                    <span class="grid size-11 place-items-center rounded-xl bg-brand/10 text-brand">
                      <Icon name="quote" size={22} />
                    </span>
                    <span class="flex gap-1 text-brand" aria-label={`Calificación ${t.rating} de 5`}>
                      {
                        Array.from({ length: t.rating }).map(() => (
                          <Icon name="star" size={14} />
                        ))
                      }
                    </span>
                  </div>

                  <blockquote class="mt-6 flex-1 text-base leading-relaxed text-white/70">
                    "{t.quote}"
                  </blockquote>

                  <figcaption class="mt-8 flex items-center gap-4 border-t border-white/8 pt-6">
                    <img
                      src={asset(t.avatar)}
                      alt={`Avatar de ${t.name}`}
                      width="200"
                      height="200"
                      loading="lazy"
                      class="size-12 rounded-full border border-brand/30 object-cover"
                    />
                    <div>
                      <p class="font-display text-sm font-semibold text-white">{t.name}</p>
                      <p class="text-xs text-white/45">{t.role}</p>
                    </div>
                  </figcaption>
                </figure>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-8 flex items-center justify-between">
        <div id="testimonials-pagination" class="swiper-pagination !static flex w-auto gap-2" />
        <div class="flex gap-3">
          <button
            id="testimonials-prev"
            type="button"
            class="grid size-11 place-items-center rounded-full border border-white/10 bg-white/5 text-white/70 transition-colors hover:border-brand hover:text-brand"
            aria-label="Testimonio anterior"
            data-cursor="hover"
          >
            <Icon name="chevron-right" size={18} class="rotate-180" />
          </button>
          <button
            id="testimonials-next"
            type="button"
            class="grid size-11 place-items-center rounded-full border border-white/10 bg-white/5 text-white/70 transition-colors hover:border-brand hover:text-brand"
            aria-label="Testimonio siguiente"
            data-cursor="hover"
          >
            <Icon name="chevron-right" size={18} />
          </button>
        </div>
      </div>
    </Reveal>
  </div>
</section>
