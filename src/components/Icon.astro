---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class:list={['shrink-0', className]}
  aria-hidden="true"
  set:html={mode === 'stroke' ? `<g ${commonAttrs}>${inner}</g>` : `<g fill="currentColor">${inner}</g>`}
/>
