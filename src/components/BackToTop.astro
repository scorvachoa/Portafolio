---
/**
 * Botón flotante para volver arriba.
 */
---

<button
  id="back-to-top"
  type="button"
  aria-label="Volver arriba"
  class="back-to-top glass fixed bottom-6 right-6 z-[80] grid size-12 place-items-center rounded-full border-white/10 text-white/70 opacity-0 transition-all duration-500 hover:border-brand hover:text-brand"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
    <path d="m5 12 7-7 7 7" />
    <path d="M12 19V5" />
  </svg>
</button>
