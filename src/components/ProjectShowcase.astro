---
/**
 * Tarjeta de caso de éxito completa: hero, contexto, solución, resultados y galería.
 */
import type { Project } from '@/data/types';
import { asset } from '@/utils/asset';
import Icon from '@/components/Icon.astro';
import Reveal from '@/components/Reveal.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const details = [
  { icon: 'target', title: 'Objetivo', text: project.objective },
  { icon: 'lightbulb', title: 'Problema', text: project.problem },
  { icon: 'sparkles', title: 'Solución', text: project.solution },
];
---

<article id={project.id} class="relative border-t border-white/8 py-20 sm:py-28">
  <div class="container-page">
    {/* Encabezado del caso */}
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <Reveal class="lg:col-span-7">
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <span class="chip">{project.category}</span>
          <span class="chip">{project.year}</span>
          <span class="text-white/40">Cliente: {project.client}</span>
        </div>
        <h3 class="mt-6 font-display text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-5xl">
          {project.title}
        </h3>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/55 sm:text-lg">
          {project.summary}
        </p>
      </Reveal>

      <Reveal delay="0.1" class="lg:col-span-5 lg:flex lg:justify-end">
        <span class="font-display text-7xl font-bold text-transparent sm:text-8xl lg:text-9xl"
          style="-webkit-text-stroke: 1px rgb(255 255 255 / 0.14)"
          aria-hidden="true"
        >
          {String(index + 1).padStart(2, '0')}
        </span>
      </Reveal>
    </div>

    {/* Hero del proyecto */}
    <Reveal class="mt-12">
      <div class="group relative overflow-hidden rounded-3xl border border-white/10" data-cursor="hover">
        <div class="overflow-hidden">
          <img
            src={asset(project.hero)}
            alt={`Imagen principal de ${project.title}`}
            width="1600"
            height="900"
            loading="lazy"
            class="aspect-[16/9] w-full object-cover transition-transform duration-[1.2s] ease-out group-hover:scale-105"
          />
        </div>

        <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-transparent to-transparent" aria-hidden="true" />

        {
          project.link ? (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="absolute bottom-5 left-5 flex items-center gap-3 rounded-full glass px-5 py-3 text-sm font-medium text-white transition-colors duration-300 hover:text-brand"
              aria-label={project.video.label}
              data-cursor="hover"
            >
              <span class="grid size-9 place-items-center rounded-full bg-brand text-white transition-transform duration-300 group-hover:scale-110">
                <Icon name="play" size={16} />
              </span>
              {project.video.label}
            </a>
          ) : (
            <button
              type="button"
              data-video-open
              data-video-id={project.video.id}
              class="absolute bottom-5 left-5 flex items-center gap-3 rounded-full glass px-5 py-3 text-sm font-medium text-white transition-colors duration-300 hover:text-brand"
              aria-label={project.video.label}
            >
              <span class="grid size-9 place-items-center rounded-full bg-brand text-white transition-transform duration-300 group-hover:scale-110">
                <Icon name="play" size={16} />
              </span>
              {project.video.label}
            </button>
          )
        }
      </div>
    </Reveal>

    {/* Detalles del caso */}
    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {
        details.map((detail, i) => (
          <Reveal delay={i * 0.08} class="h-full">
            <div class="card h-full p-6">
              <div class="flex items-center gap-3">
                <span class="grid size-9 place-items-center rounded-lg bg-brand/10 text-brand">
                  <Icon name={detail.icon} size={18} />
                </span>
                <h4 class="font-display text-sm font-semibold uppercase tracking-wide text-white/80">
                  {detail.title}
                </h4>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-white/55">{detail.text}</p>
            </div>
          </Reveal>
        ))
      }
    </div>

    {/* Mi participación + herramientas */}
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <Reveal delay="0.05" class="h-full">
        <div class="card h-full p-6">
          <div class="flex items-center gap-3">
            <span class="grid size-9 place-items-center rounded-lg bg-brand/10 text-brand">
              <Icon name="users" size={18} />
            </span>
            <h4 class="font-display text-sm font-semibold uppercase tracking-wide text-white/80">
              Mi participación
            </h4>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-white/55">{project.myRole}</p>
        </div>
      </Reveal>

      <Reveal delay="0.1" class="h-full md:col-span-2">
        <div class="card h-full p-6">
          <div class="flex items-center gap-3">
            <span class="grid size-9 place-items-center rounded-lg bg-brand/10 text-brand">
              <Icon name="wrench" size={18} />
            </span>
            <h4 class="font-display text-sm font-semibold uppercase tracking-wide text-white/80">
              Herramientas utilizadas
            </h4>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              project.tools.map((tool) => (
                <span class="rounded-full border border-white/10 bg-white/4 px-4 py-1.5 text-xs text-white/60 transition-colors duration-300 hover:border-brand/50 hover:text-brand">
                  {tool}
                </span>
              ))
            }
          </div>
        </div>
      </Reveal>
    </div>

    {/* Resultados en grande */}
    <Reveal class="mt-4">
      <div class="card relative overflow-hidden p-8 sm:p-10">
        <div
          class="pointer-events-none absolute inset-0 opacity-60"
          style="background: radial-gradient(700px 200px at 20% 0%, rgb(14 165 233 / 0.12), transparent)"
          aria-hidden="true"
        />
        <h4 class="relative font-display text-xs font-semibold uppercase tracking-[0.3em] text-brand">
          Resultados
        </h4>
        <div class="relative mt-8 grid gap-8 sm:grid-cols-3">
          {
            project.results.map((result) => (
              <div class="flex flex-col">
                <span class="font-display text-5xl font-bold tracking-tight text-white sm:text-6xl">
                  <span data-counter={result.value} data-suffix={result.suffix}>0{result.suffix}</span>
                </span>
                <span class="mt-3 text-sm text-white/50">{result.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </Reveal>
  </div>
</article>
