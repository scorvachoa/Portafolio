---
/**
 * Wrapper de reveal: cualquier bloque envuelto aquí aparece con fade+slide
 * al entrar en el viewport (manejado por el script global de animaciones).
 */
interface Props {
  delay?: number | string;
  class?: string;
}

const { delay = 0, class: className = '' } = Astro.props;
const classes = ['data-reveal', className].filter(Boolean).join(' ');
---

<div data-reveal data-delay={delay} class:list={[classes]}>
  <slot />
</div>
