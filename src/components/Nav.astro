---
/**
 * Navegación principal: glass al hacer scroll + menú móvil.
 */
import navigation from '@/data/navigation.json';
import site from '@/data/site.json';
import { asset } from '@/utils/asset';
import Icon from './Icon.astro';

const links = navigation.links;
const cta = navigation.cta;
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-[70] transition-all duration-500"
  style="background: transparent"
>
  <div class="container-page flex h-[72px] items-center justify-between">
    <a href="#inicio" class="group flex items-center gap-3" aria-label="Ir al inicio" data-cursor="hover">
      <span class="grid size-9 place-items-center rounded-lg bg-brand/15 font-display text-sm font-bold text-brand transition-colors duration-300 group-hover:bg-brand group-hover:text-white">
        SC
      </span>
      <span class="hidden font-display text-sm font-semibold tracking-wide text-white sm:block">
        {site.fullName}
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-2 text-sm text-white/65 transition-colors duration-300 hover:text-brand"
            data-cursor="hover"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={asset(cta.href)}
        class="hidden items-center gap-2 rounded-full border border-brand/40 bg-brand/10 px-5 py-2 text-sm font-medium text-brand transition-all duration-300 hover:bg-brand hover:text-white md:inline-flex"
        download
        data-cursor="hover"
      >
        <Icon name="download" size={16} />
        {cta.label}
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="grid size-10 place-items-center rounded-full border border-white/10 bg-white/5 text-white lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-cursor="hover"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="glass fixed inset-0 z-[60] flex flex-col justify-between px-6 pb-10 pt-24 opacity-0 transition-opacity duration-400 pointer-events-none"
>
  <nav class="flex flex-col gap-2" aria-label="Navegación móvil">
    {
      links.map((link, index) => (
        <a
          href={link.href}
          class="group flex items-center justify-between border-b border-white/5 py-4 font-display text-3xl font-semibold text-white/80 transition-colors hover:text-brand"
          data-cursor="hover"
        >
          <span>{link.label}</span>
          <span class="text-sm text-brand opacity-0 transition-opacity group-hover:opacity-100">0{index + 1}</span>
        </a>
      ))
    }
  </nav>

  <div class="flex items-center justify-between">
    <a href={asset(cta.href)} download class="btn-primary" data-cursor="hover">
      <Icon name="download" size={18} />
      {cta.label}
    </a>
    <a href={`mailto:${site.email}`} class="text-sm text-white/50 hover:text-brand" data-cursor="hover">
      {site.email}
    </a>
  </div>
</div>
