---
/**
 * Botón reutilizable con variantes (primary / ghost) e icono opcional.
 */
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'sm';
  href?: string;
  type?: 'button' | 'submit';
  icon?: string;
  iconRight?: string;
  target?: '_blank' | '_self';
  download?: boolean;
  label?: string;
  class?: string;
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  icon,
  iconRight,
  target = '_self',
  download = false,
  label,
  class: className = '',
  'aria-label': ariaLabel,
} = Astro.props;

const variantClass = variant === 'primary' ? 'btn-primary' : 'btn-ghost';
const sizeClass = size === 'sm' ? 'btn-sm' : '';

const base = `group relative inline-flex items-center justify-center gap-2.5 rounded-full font-display font-medium tracking-tight transition-all duration-300 select-none ${variantClass} ${sizeClass}`;
const classes = [base, className].filter(Boolean).join(' ');

const attrs: Record<string, string> = {};
if (href) {
  attrs.href = href;
  attrs.target = target;
  if (target === '_blank') attrs.rel = 'noopener noreferrer';
  if (download) attrs.download = 'true';
}
if (label) attrs['aria-label'] = label;
if (ariaLabel) attrs['aria-label'] = ariaLabel;
---

{
  href ? (
    <a {...attrs} class={classes} data-cursor="hover">
      {icon && <Icon name={icon} size={size === 'sm' ? 16 : 18} />}
      <slot />
      {iconRight && (
        <Icon
          name={iconRight}
          size={size === 'sm' ? 16 : 18}
          class="transition-transform duration-300 group-hover:translate-x-1"
        />
      )}
    </a>
  ) : (
    <button type={type} class={classes} data-cursor="hover">
      {icon && <Icon name={icon} size={size === 'sm' ? 16 : 18} />}
      <slot />
      {iconRight && (
        <Icon
          name={iconRight}
          size={size === 'sm' ? 16 : 18}
          class="transition-transform duration-300 group-hover:translate-x-1"
        />
      )}
    </button>
  )
}
